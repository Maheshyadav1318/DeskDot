<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- DeskDot palette: near-black island, warm amber accent -->
  <Color x:Key="IslandBackgroundColor">#0A0A0C</Color>
  <Color x:Key="AccentColor">#F5B942</Color>

  <SolidColorBrush x:Key="IslandBrush" Color="{StaticResource IslandBackgroundColor}" />
  <SolidColorBrush x:Key="IslandBorderBrush" Color="#22FFFFFF" />
  <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7" />
  <SolidColorBrush x:Key="TextDimBrush" Color="#A1A1AA" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#29F5B942" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#0DFFFFFF" />
  <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="TrackBrush" Color="#1FFFFFFF" />

  <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <CornerRadius x:Key="IslandRadius">26</CornerRadius>
  <CornerRadius x:Key="CardRadius">14</CornerRadius>

  <!-- Text styles -->
  <Style x:Key="LabelText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="ClockText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontSize" Value="40" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="42" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <Style x:Key="CardBorder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

</ResourceDictionary>
