<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- DeskDot "a little space" palette: warm paper, sage accent, generous whitespace -->
  <Color x:Key="PageColor">#F7F5F0</Color>
  <Color x:Key="SageColor">#6E7F6A</Color>

  <SolidColorBrush x:Key="PageBrush" Color="{StaticResource PageColor}" />
  <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="#EDE9E1" />
  <SolidColorBrush x:Key="InkBrush" Color="#20211D" />
  <SolidColorBrush x:Key="InkSoftBrush" Color="#6C6F66" />
  <SolidColorBrush x:Key="InkFaintBrush" Color="#9EA096" />
  <SolidColorBrush x:Key="SageBrush" Color="{StaticResource SageColor}" />
  <SolidColorBrush x:Key="SageSoftBrush" Color="#EAF0E6" />
  <SolidColorBrush x:Key="SageDeepBrush" Color="#4C5A48" />
  <SolidColorBrush x:Key="SandBrush" Color="#F0EAE0" />
  <SolidColorBrush x:Key="TrackBrush" Color="#EFEBE3" />
  <SolidColorBrush x:Key="HeroOverlayBrush" Color="#C0505F55" />

  <FontFamily x:Key="DisplayFont">Georgia</FontFamily>
  <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

  <Style x:Key="KickerText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="CardBody" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="CardCaption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <!-- Base card surface -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="20,18" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.05" Color="#3B3A33" />
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
