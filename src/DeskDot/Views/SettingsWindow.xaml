<Window x:Class="DeskDot.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskDot Setup"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#0E0E11"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal">

  <Border Padding="24,20" Background="#0E0E11">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Text="DeskDot Setup" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
      </StackPanel>
      <TextBlock Text="DeskDot · D.R.M.Y ✨" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="20,0,0,18" />

      <!-- Behaviour -->
      <TextBlock Text="BEHAVIOUR" Style="{StaticResource LabelText}" Margin="0,0,0,8" />

      <CheckBox x:Name="AlwaysOnTopCheck" Style="{StaticResource SettingsToggle}"
                Content="Keep the island above other windows" Margin="0,0,0,12" />

      <CheckBox x:Name="CollapseOnFocusLossCheck" Style="{StaticResource SettingsToggle}"
                Content="Collapse when the island loses focus" Margin="0,0,0,12" />

      <CheckBox x:Name="StartWithWindowsCheck" Style="{StaticResource SettingsToggle}"
                Content="Start DeskDot with Windows" Margin="0,0,0,18" />

      <!-- Personalisation -->
      <TextBlock Text="PERSONALISATION" Style="{StaticResource LabelText}" Margin="0,0,0,8" />

      <TextBlock Text="Your name (shown in the greeting)" FontSize="12.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
      <TextBox x:Name="DisplayNameBox" Padding="10,7" FontSize="13" Background="#1AFFFFFF"
               Foreground="{StaticResource TextBrush}" BorderBrush="#26FFFFFF" BorderThickness="1"
               CaretBrush="{StaticResource AccentBrush}" Margin="0,0,0,14" />

      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="Toggle hotkey" FontSize="12.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
          <ComboBox x:Name="HotkeyBox" Padding="8,6" FontSize="13" Background="#F2F2F4"
                    Foreground="#111111" BorderBrush="#26FFFFFF" />
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Text="Focus length (minutes)" FontSize="12.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
          <ComboBox x:Name="FocusLengthBox" Padding="8,6" FontSize="13" Background="#F2F2F4"
                    Foreground="#111111" BorderBrush="#26FFFFFF" />
        </StackPanel>
      </Grid>


      <!-- Footer -->
      <Grid Margin="0,4,0,0">
        <TextBlock Foreground="{StaticResource TextDimBrush}" FontSize="11.5"
                   VerticalAlignment="Center" Text="Settings save to %APPDATA%\DeskDot\settings.json" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" Style="{StaticResource GhostMiniButton}" Padding="16,7"
                  Click="OnCancelClick" Margin="0,0,8,0" />
          <Button Content="Save" Style="{StaticResource MiniButton}" Padding="20,7" Click="OnSaveClick" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</Window>
