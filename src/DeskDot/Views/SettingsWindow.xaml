<Window x:Class="DeskDot.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskDot Setup"
        Width="560" Height="620"
        MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="24,20,24,10">
      <StackPanel Orientation="Horizontal">
        <Ellipse Width="9" Height="9" Fill="{StaticResource SageBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
        <TextBlock Text="Make yourself at home." FontFamily="{StaticResource DisplayFont}" FontSize="21"
                   Foreground="{StaticResource InkBrush}" />
      </StackPanel>
      <TextBlock Text="Everything is stored on this PC in %APPDATA%\DeskDot." Style="{StaticResource CardCaption}"
                 Margin="18,4,0,0" />
    </StackPanel>

    <TabControl Grid.Row="1" x:Name="Tabs" Margin="18,0,18,0" Background="Transparent" BorderThickness="0">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
          <Setter Property="FontSize" Value="12.5" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Border x:Name="Root" Padding="14,8" Margin="0,0,6,0" CornerRadius="10" Background="Transparent">
                  <ContentPresenter ContentSource="Header" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{StaticResource SageSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource SageDeepBrush}" />
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{StaticResource SandBrush}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.Resources>

      <!-- General -->
      <TabItem Header="General">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,14,4,14">
            <TextBlock Text="WINDOW" Style="{StaticResource KickerText}" Margin="0,0,0,10" />

            <CheckBox x:Name="AlwaysOnTopCheck" Style="{StaticResource Switch}"
                      Content="Keep DeskDot above other windows" Margin="0,0,0,12" />
            <CheckBox x:Name="StartMinimisedCheck" Style="{StaticResource Switch}"
                      Content="Start minimised to the tray" Margin="0,0,0,12" />
            <CheckBox x:Name="StartWithWindowsCheck" Style="{StaticResource Switch}"
                      Content="Start DeskDot with Windows" Margin="0,0,0,16" />

            <TextBlock Text="YOUR NAME" Style="{StaticResource KickerText}" Margin="0,0,0,6" />
            <TextBox x:Name="DisplayNameBox" Style="{StaticResource QuietTextBox}" Margin="0,0,0,16"
                     ToolTip="Shown in the greeting. Leave empty to use your Windows account name." />

            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Text="SHOW / HIDE HOTKEY" Style="{StaticResource KickerText}" Margin="0,0,0,6" />
                <ComboBox x:Name="ToggleHotkeyBox" Style="{StaticResource QuietComboBox}" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Text="OPEN SETTINGS HOTKEY" Style="{StaticResource KickerText}" Margin="0,0,0,6" />
                <ComboBox x:Name="SettingsHotkeyBox" Style="{StaticResource QuietComboBox}" />
              </StackPanel>
            </Grid>

            <TextBlock Text="FOCUS LENGTH" Style="{StaticResource KickerText}" Margin="0,0,0,6" />
            <ComboBox x:Name="FocusLengthBox" Style="{StaticResource QuietComboBox}" Width="160"
                      HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Modules -->
      <TabItem Header="Modules">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,14,4,14">
            <TextBlock Text="Turn things on and off. Private modules stay off until you choose them."
                       Style="{StaticResource CardBody}" Margin="0,0,0,14" />

            <ItemsControl x:Name="ModulesList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                          BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardBody}"
                                   Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource CardCaption}" />
                      </StackPanel>
                      <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Weather -->
      <TabItem Header="Weather">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,14,4,14">
            <CheckBox x:Name="WeatherEnabledCheck" Style="{StaticResource Switch}"
                      Content="Show live weather" Margin="0,0,0,14" />

            <TextBlock Text="CITY" Style="{StaticResource KickerText}" Margin="0,0,0,6" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="WeatherLocationBox" Grid.Column="0" Style="{StaticResource QuietTextBox}" />
              <Button Grid.Column="2" Content="Look up" Style="{StaticResource GhostPill}"
                      Click="OnLookUpWeather" />
            </Grid>
            <TextBlock x:Name="WeatherStatusText" Style="{StaticResource CardCaption}" Margin="0,8,0,14"
                       TextWrapping="Wrap"
                       Text="Type your city and press Look up once — DeskDot needs the coordinates before it can ask for a forecast." />

            <CheckBox x:Name="FahrenheitCheck" Style="{StaticResource Switch}"
                      Content="Show temperatures in °F" Margin="0,0,0,16" />

            <Border Background="{StaticResource SandBrush}" CornerRadius="12" Padding="14,12">
              <StackPanel>
                <TextBlock Text="About the only network request" Style="{StaticResource CardBody}"
                           Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource CardCaption}" TextWrapping="Wrap"
                           Text="DeskDot sends your chosen city's coordinates to Open-Meteo (open-meteo.com) to fetch conditions. No API key, no account, no analytics, and nothing else ever leaves this PC. Turn it off above to keep DeskDot fully offline." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Privacy -->
      <TabItem Header="Privacy">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,14,4,14">
            <TextBlock Text="PRIVATE MODULES" Style="{StaticResource KickerText}" Margin="0,0,0,10" />

            <CheckBox x:Name="ClipboardCheck" Style="{StaticResource Switch}"
                      Content="Keep a clipboard history (text only)" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource CardCaption}" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="Whatever you copy lands here — including anything you copy from a password manager. History lives in memory for this session only, is capped at 25 entries, and is cleared when you turn this off. Off by default." />

            <CheckBox x:Name="MaskSensitiveCheck" Style="{StaticResource Switch}"
                      Content="Mask clipboard entries that look like secrets" Margin="0,0,0,14" />

            <CheckBox x:Name="ScreenTimeCheck" Style="{StaticResource Switch}"
                      Content="Record screen time totals" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource CardCaption}" TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="Records how long each application is in the foreground, as daily totals in %APPDATA%\DeskDot\screentime.json. Window titles, page addresses and content are never read or stored. Off by default." />

            <Border Background="{StaticResource SageSoftBrush}" CornerRadius="12" Padding="14,12">
              <StackPanel>
                <TextBlock Text="What DeskDot never does" Style="{StaticResource CardBody}"
                           Foreground="{StaticResource SageDeepBrush}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource CardCaption}" TextWrapping="Wrap"
                           Text="No telemetry. No analytics. No account. No elevation. No hidden sync. The only request it can make is the weather lookup you enable above, and your notes, clipboard and screen time stay in local files under %APPDATA%\DeskDot." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Footer -->
    <Grid Grid.Row="2" Margin="24,12,24,18">
      <TextBlock x:Name="InlineStatus" Style="{StaticResource CardCaption}" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource GhostPill}" Click="OnCancel" Margin="0,0,8,0" />
        <Button Content="Save changes" Style="{StaticResource PrimaryPill}" Click="OnSave" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
