<Window x:Class="DeskDot.Views.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard — DeskDot"
        Width="520" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="Clipboard" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                 Foreground="{StaticResource InkBrush}" />
      <TextBlock Style="{StaticResource CardCaption}" TextWrapping="Wrap" Margin="0,4,0,0"
                 Text="Text you copied this session. Held in memory only, capped at 25 entries, and gone when DeskDot exits. Entries that look like secrets are masked." />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
        <ItemsControl x:Name="EntriesList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource SandBrush}" CornerRadius="12" Padding="14,11" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Display}" Style="{StaticResource CardBody}"
                               Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"
                               MaxHeight="56" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Age}" Style="{StaticResource CardCaption}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Copy" Style="{StaticResource LinkButton}"
                          VerticalAlignment="Top" Tag="{Binding Text}" Click="OnCopyEntry" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource CardCaption}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Text="Nothing copied yet. Copy some text and it will appear here." />

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Button Content="Clear history" Style="{StaticResource GhostPill}" HorizontalAlignment="Left"
              Click="OnClear" />
      <Button Content="Close" Style="{StaticResource GhostPill}" HorizontalAlignment="Right"
              Click="OnClose" />
    </Grid>
  </Grid>
</Window>
