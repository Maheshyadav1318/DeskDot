<Window x:Class="DeskDot.Views.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notes — DeskDot"
        Width="560" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Notes" FontFamily="{StaticResource DisplayFont}" FontSize="22"
               Foreground="{StaticResource InkBrush}" Margin="0,0,0,4" />
    <TextBlock Grid.Row="0" Text="Saved to %APPDATA%\DeskDot\notes.json — nothing leaves this PC."
               Style="{StaticResource CardCaption}" VerticalAlignment="Bottom" Margin="0,0,0,2"
               HorizontalAlignment="Right" />

    <!-- Composer -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,12">
      <StackPanel>
        <TextBlock Text="NEW NOTE" Style="{StaticResource KickerText}" Margin="0,0,0,8" />
        <TextBox x:Name="BodyBox" Style="{StaticResource QuietTextBox}" Height="86"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 ToolTip="Write anything. The first line becomes the title." />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="Save note" Style="{StaticResource PrimaryPill}" Click="OnSaveNote" Margin="0,0,8,0" />
          <TextBlock x:Name="StatusText" Style="{StaticResource CardCaption}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Existing notes -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
        <ItemsControl x:Name="NotesList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource SandBrush}" CornerRadius="12" Padding="14,11" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardBody}"
                               Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CardCaption}"
                               TextTrimming="CharacterEllipsis" MaxHeight="34" />
                    <TextBlock Text="{Binding UpdatedAt, StringFormat=Updated {0:ddd d MMM, HH:mm}}"
                               Style="{StaticResource CardCaption}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Delete" Style="{StaticResource LinkButton}"
                          VerticalAlignment="Top" Tag="{Binding Id}" Click="OnDeleteNote" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <TextBlock x:Name="EmptyText" Grid.Row="2" Style="{StaticResource CardCaption}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Text="No notes yet. Your first one can be one line." />

    <Button Grid.Row="3" Content="Close" Style="{StaticResource GhostPill}" HorizontalAlignment="Right"
            Margin="0,12,0,0" Click="OnClose" />
  </Grid>
</Window>
