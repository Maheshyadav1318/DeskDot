<Window x:Class="DeskDot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeskDot.ViewModels"
        xmlns:local="clr-namespace:DeskDot"
        Title="DeskDot — A little space. A better day."
        Width="1160" Height="880"
        MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Week bars bind a 0..1 ratio; the ProgressBar style expects 0..100. -->
    <local:RatioToPercentConverter x:Key="PercentToValue" />

    <!-- Small inline stat used in the system card -->
    <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource CardCaption}">
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ================= Chrome / header ================= -->
    <Grid Grid.Row="0" Margin="28,18,28,8">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse Width="9" Height="9" Fill="{StaticResource SageBrush}" Margin="0,0,9,0" />
        <TextBlock Text="DeskDot" FontFamily="{StaticResource DisplayFont}" FontSize="17"
                   Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
        <TextBlock Text="  ·  A little space. A better day." Style="{StaticResource CardCaption}"
                   VerticalAlignment="Center" Margin="4,0,0,0" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                  WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Content="Customize" Style="{StaticResource GhostPill}" Click="OnOpenSettings"
                Margin="0,0,8,0" ToolTip="Modules, weather, privacy" />
        <Button Content="Modules" Style="{StaticResource GhostPill}" Click="OnOpenModules" />
      </StackPanel>
    </Grid>

    <!-- ================= Scrolling body ================= -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Focusable="False">
      <StackPanel Margin="28,6,22,24">

        <!-- ---------- Focus + weather ---------- -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.35*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>

          <!-- Focus -->
          <Border Grid.Column="0" Style="{StaticResource Card}" Visibility="{Binding TimersVisible, Converter={StaticResource BoolToVis}}"
                  Background="{StaticResource SageSoftBrush}">
            <StackPanel>
              <TextBlock Text="A LITTLE FOCUS" Style="{StaticResource KickerText}" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="{Binding FocusText}" FontFamily="{StaticResource DisplayFont}" FontSize="54"
                           Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                <StackPanel Margin="18,6,0,0">
                  <TextBlock Text="One thing at a time" Style="{StaticResource CardBody}"
                             Foreground="{StaticResource SageDeepBrush}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Greeting}" Style="{StaticResource CardBody}" Margin="0,2,0,0" />
                </StackPanel>
              </StackPanel>

              <ProgressBar Style="{StaticResource Meter}" Value="{Binding FocusPercent, Mode=OneWay}"
                           Margin="0,14,0,14" Background="#DCE5D6" />

              <StackPanel Orientation="Horizontal">
                <Button Content="{Binding FocusActionLabel}" Style="{StaticResource PrimaryPill}"
                        Click="OnFocusToggle" Margin="0,0,8,0" />
                <Button Content="Reset" Style="{StaticResource GhostPill}" Click="OnFocusReset" />
                <TextBlock Text="{Binding AgendaCountLabel}" Style="{StaticResource CardCaption}"
                           VerticalAlignment="Center" Margin="14,0,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Weather -->
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"
                  Visibility="{Binding WeatherVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Border Height="118" CornerRadius="18,18,0,0" ClipToBounds="True">
                <Grid>
                  <Image Source="pack://application:,,,/Assets/dashboard-hero.jpg" Stretch="UniformToFill" />
                  <Border Background="#CC3E4A42" />
                  <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,14">
                    <TextBlock Text="{Binding WeatherLocation}" Foreground="#F3F1EA" FontSize="12"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding WeatherTemperature}" Foreground="#FFFFFF"
                                 FontFamily="{StaticResource DisplayFont}" FontSize="34" />
                      <TextBlock Text="{Binding WeatherDescription}" Foreground="#E7E9E2" FontSize="12.5"
                                 VerticalAlignment="Bottom" Margin="10,0,0,7" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Text="{Binding WeatherGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="22"
                             Foreground="#F3F1EA" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,14,18,0" />
                </Grid>
              </Border>

              <StackPanel Grid.Row="1" Margin="18,14,18,16">
                <TextBlock Text="{Binding WeatherAside}" Style="{StaticResource CardBody}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Text="{Binding WeatherHigh}" Style="{StaticResource CardCaption}" Margin="0,0,10,0" />
                  <TextBlock Text="{Binding WeatherLow}" Style="{StaticResource CardCaption}" Margin="0,0,10,0" />
                  <TextBlock Text="{Binding WeatherHumidity}" Style="{StaticResource CardCaption}" Margin="0,0,10,0" />
                  <TextBlock Text="{Binding WeatherWind}" Style="{StaticResource CardCaption}" />
                </StackPanel>
                <TextBlock Text="{Binding WeatherUpdated}" Style="{StaticResource CardCaption}"
                           Margin="0,6,0,0" Foreground="{StaticResource InkFaintBrush}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <!-- ---------- System + screen time ---------- -->
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1.35*" />
          </Grid.ColumnDefinitions>

          <!-- This PC -->
          <Border Grid.Column="0" Style="{StaticResource Card}"
                  Visibility="{Binding SystemVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="THIS PC · LIVE" Style="{StaticResource KickerText}" VerticalAlignment="Center" />
                <Ellipse Width="6" Height="6" Fill="{StaticResource SageBrush}" Margin="8,0,0,0"
                         VerticalAlignment="Center" />
              </StackPanel>

              <TextBlock Text="CPU" Style="{StaticResource StatLabel}" Margin="0,16,0,4" />
              <Grid>
                <ProgressBar Style="{StaticResource Meter}" Value="{Binding CpuPercent, Mode=OneWay}" />
                <TextBlock Text="{Binding CpuText}" Style="{StaticResource CardCaption}" FontWeight="Bold"
                           Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right"
                           Margin="0,-18,0,0" />
              </Grid>

              <TextBlock Text="MEMORY" Style="{StaticResource StatLabel}" Margin="0,14,0,4" />
              <Grid>
                <ProgressBar Style="{StaticResource Meter}" Value="{Binding MemoryPercent, Mode=OneWay}" />
                <TextBlock Text="{Binding MemoryText}" Style="{StaticResource CardCaption}" FontWeight="Bold"
                           Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right"
                           Margin="0,-18,0,0" />
              </Grid>

              <TextBlock Text="BATTERY" Style="{StaticResource StatLabel}" Margin="0,14,0,4" />
              <Grid>
                <ProgressBar Style="{StaticResource Meter}" Value="{Binding BatteryPercent, Mode=OneWay}"
                             Foreground="#8FA98A" />
                <TextBlock Text="{Binding BatteryText}" Style="{StaticResource CardCaption}" FontWeight="Bold"
                           Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right"
                           Margin="0,-18,0,0" />
              </Grid>

              <TextBlock Text="No drivers · No elevation   ·   pauses when hidden"
                         Style="{StaticResource CardCaption}" Margin="0,16,0,0" />
            </StackPanel>
          </Border>

          <!-- Screen time -->
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <TextBlock Text="SCREEN TIME" Style="{StaticResource KickerText}" />
                <Button Content="Details" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Click="OnScreenTimeDetails" />
              </Grid>

              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="{Binding ScreenTimeTotal}" FontFamily="{StaticResource DisplayFont}"
                           FontSize="34" Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="{Binding ScreenTimeTrend}" Style="{StaticResource CardCaption}"
                           VerticalAlignment="Bottom" Margin="10,0,0,7" FontWeight="Bold" />
              </StackPanel>

              <TextBlock Text="{Binding ScreenTimeNote}" Style="{StaticResource CardBody}" Margin="0,4,0,12" />

              <ItemsControl ItemsSource="{Binding ScreenTimeWeek}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,6,0" Height="46" VerticalAlignment="Bottom">
                      <ProgressBar Style="{StaticResource WeekBar}" VerticalAlignment="Bottom"
                                   Value="{Binding Converter={StaticResource PercentToValue}}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding TopApps}" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CardBody}"
                                 Foreground="{StaticResource InkBrush}" />
                      <TextBlock Style="{StaticResource CardCaption}" HorizontalAlignment="Right"
                                 Text="{Binding DurationText}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding ScreenTimeFooter}" Style="{StaticResource CardCaption}"
                         Margin="0,12,0,0" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- ---------- Reminder + clipboard ---------- -->
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource Card}" Background="{StaticResource SandBrush}">
            <StackPanel>
              <TextBlock Text="A LITTLE REMINDER" Style="{StaticResource KickerText}" />
              <TextBlock Text="{Binding QuoteText}" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                         Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,10,0,12"
                         LineHeight="28" />
              <StackPanel Orientation="Horizontal">
                <Button Content="Just for you" Style="{StaticResource GhostPill}" Click="OnNextQuote" Margin="0,0,8,0" />
                <Button Content="Open notes" Style="{StaticResource GhostPill}" Click="OnOpenNotes" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource Card}"
                  Visibility="{Binding ClipboardVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <Grid>
                <TextBlock Text="CLIPBOARD" Style="{StaticResource KickerText}" />
                <Button Content="View all" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Click="OnOpenClipboard" />
              </Grid>

              <TextBlock Text="{Binding ClipboardPreview}" Style="{StaticResource CardBody}"
                         Foreground="{StaticResource InkBrush}" Margin="0,10,0,6" MaxHeight="56"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding ClipboardAge}" Style="{StaticResource CardCaption}" />

              <TextBlock Text="{Binding ClipboardCount}" Style="{StaticResource CardCaption}" Margin="0,14,0,0" />
              <TextBlock Text="Stays on your device" Style="{StaticResource CardCaption}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- ---------- Up next + notes ---------- -->
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.35*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource Card}"
                  Visibility="{Binding CalendarVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <Grid>
                <TextBlock Text="UP NEXT" Style="{StaticResource KickerText}" />
                <TextBlock Text="{Binding AgendaCountLabel}" Style="{StaticResource CardCaption}"
                           HorizontalAlignment="Right" />
              </Grid>

              <ItemsControl ItemsSource="{Binding UpNext}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource CardCaption}"
                                 FontWeight="Bold" Foreground="{StaticResource SageBrush}" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardBody}"
                                   Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CardCaption}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="A little breathing room in between." Style="{StaticResource CardCaption}"
                         Margin="0,2,0,0" />
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource Card}"
                  Visibility="{Binding NotesVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <Grid>
                <TextBlock Text="NOTES" Style="{StaticResource KickerText}" />
                <TextBlock Text="{Binding NotesCount}" Style="{StaticResource CardCaption}"
                           HorizontalAlignment="Right" />
              </Grid>

              <TextBlock Text="{Binding LatestNoteTitle}" FontFamily="{StaticResource DisplayFont}"
                         FontSize="17" Foreground="{StaticResource InkBrush}" Margin="0,10,0,4"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding LatestNoteBody}" Style="{StaticResource CardBody}" MaxHeight="46" />

              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="New note" Style="{StaticResource PrimaryPill}" Click="OnNewNote" Margin="0,0,8,0" />
                <Button Content="All notes" Style="{StaticResource GhostPill}" Click="OnOpenNotes" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ---------- Modules strip ---------- -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
          <StackPanel>
            <Grid>
              <TextBlock Text="YOUR MODULES" Style="{StaticResource KickerText}" />
              <TextBlock Text="{Binding EnabledModuleCount}" Style="{StaticResource CardCaption}"
                         HorizontalAlignment="Right" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Modules}" Margin="0,12,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource SandBrush}" CornerRadius="12" Padding="12,8"
                          Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="6" Height="6" Fill="{StaticResource SageBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBlock Text="{Binding Name}" Style="{StaticResource CardBody}"
                                 Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,6,0,0">
              <TextBlock Text="The little things, taken care of." Style="{StaticResource CardBody}" />
              <Button Content="Manage modules" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                      Click="OnOpenModules" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ================= Footer ================= -->
    <Border Grid.Row="2" Background="#F2EFE8" BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="0,1,0,0" Padding="28,8">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding ShortDateText}" Style="{StaticResource CardCaption}" />
          <TextBlock Text="  ·  " Style="{StaticResource CardCaption}" />
          <TextBlock Text="{Binding TimeText}" Style="{StaticResource CardCaption}" FontWeight="Bold" />
          <TextBlock Text="  ·  " Style="{StaticResource CardCaption}" />
          <TextBlock Text="DeskDot · D.R.M.Y" Style="{StaticResource CardCaption}" />
        </StackPanel>
        <TextBlock HorizontalAlignment="Right" Style="{StaticResource CardCaption}">
          <Run Text="Toggle " /><Run Text="{Binding ToggleHotkeyHint, Mode=OneWay}" FontWeight="Bold" />
          <Run Text="   ·   Settings " /><Run Text="{Binding SettingsHotkeyHint, Mode=OneWay}" FontWeight="Bold" />
        </TextBlock>
      </Grid>
    </Border>
  </Grid>
</Window>
