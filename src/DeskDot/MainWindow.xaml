<Window x:Class="DeskDot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskDot"
        Width="404" Height="100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource UiFont}">

  <Grid Margin="20">
    <!-- The island: one rounded surface that morphs between pill and panel -->
    <Border x:Name="IslandSurface"
            Background="{StaticResource IslandBrush}"
            BorderBrush="{StaticResource IslandBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource IslandRadius}"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="OnIslandMouseDown">
      <Border.Effect>
        <DropShadowEffect BlurRadius="26" ShadowDepth="7" Direction="270" Opacity="0.6" Color="#000000" />
      </Border.Effect>

      <Grid ClipToBounds="True">
        <!-- ============ Collapsed pill ============ -->
        <Grid x:Name="CollapsedPanel" VerticalAlignment="Center" Margin="18,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                   VerticalAlignment="Center" Margin="0,0,10,0">
            <Ellipse.Effect>
              <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.9" Color="#F5B942" />
            </Ellipse.Effect>
            <Ellipse.Triggers>
              <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.5" Duration="0:0:1.1" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Ellipse.Triggers>
          </Ellipse>

          <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="15" FontWeight="Bold"
                     Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />

          <TextBlock Grid.Column="2" Text="  ·  " Foreground="{StaticResource TextDimBrush}"
                     VerticalAlignment="Center" FontSize="13" />

          <TextBlock Grid.Column="3" Text="{Binding DateText}" Foreground="{StaticResource TextDimBrush}"
                     FontSize="13" VerticalAlignment="Center" />

          <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"
                      VerticalAlignment="Center" Margin="16,0,14,0">
            <TextBlock Text="CPU " Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CpuText}" Foreground="{StaticResource TextBrush}" FontSize="12"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Text="RAM " Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding MemoryText}" Foreground="{StaticResource TextBrush}" FontSize="12"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Grid.Column="5" Text="DeskDot" Foreground="{StaticResource AccentBrush}"
                     FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
        </Grid>

        <!-- ============ Expanded island ============ -->
        <Grid x:Name="ExpandedPanel" Margin="24,22,24,14" Visibility="Collapsed" Opacity="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.12*" />
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Left column: greeting, clock, next up, quick actions -->
            <StackPanel Grid.Column="0">
              <TextBlock Text="{Binding Greeting}" FontSize="20" FontWeight="Bold" MaxWidth="360"
                         Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />

              <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,6,0,0">
                <TextBlock Text="{Binding TimeText}" Style="{StaticResource ClockText}" />
                <TextBlock Text="{Binding DateText}" Foreground="{StaticResource TextDimBrush}"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="12,0,0,7" />
              </StackPanel>

              <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding AgendaLabel}" Foreground="{StaticResource AccentBrush}"
                             FontSize="11" FontWeight="Bold" />
                  <TextBlock Text="{Binding AgendaTitle}" Style="{StaticResource BodyText}"
                             TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
              </Border>

              <WrapPanel Margin="0,14,0,0">
                <Button Content="DeskDot" Style="{StaticResource PillButton}" Margin="0,0,8,8"
                        Click="OnOpenSelfClick" ToolTip="Show the DeskDot folder" />
                <Button Content="Focus" Style="{StaticResource PillButton}" Margin="0,0,8,8"
                        Click="OnFocusQuickClick" ToolTip="Start a focus session" />
                <Button Content="Settings" Style="{StaticResource PillButton}" Margin="0,0,8,8"
                        Click="OnSettingsClick" />
                <Button Content="Power" Style="{StaticResource PillButton}" Margin="0,0,8,8"
                        Click="OnPowerClick" ToolTip="Open Windows power options" />
              </WrapPanel>

              <TextBlock Text="{Binding HotkeyHint}" Foreground="{StaticResource TextDimBrush}"
                         FontSize="11" Margin="2,2,0,0" />
            </StackPanel>

            <!-- Right column: media, focus, system -->
            <StackPanel Grid.Column="2">
              <!-- Now playing -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="80" Height="80" CornerRadius="16" BorderThickness="1"
                        BorderBrush="#1FFFFFFF" ClipToBounds="True" VerticalAlignment="Top">
                  <Border.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Assets/album-art.jpg" Stretch="UniformToFill" />
                  </Border.Background>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                  <TextBlock Text="{Binding TrackTitle}" Style="{StaticResource TitleText}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding TrackArtist}" Foreground="{StaticResource TextDimBrush}"
                             FontSize="12.5" Margin="0,2,0,10" TextTrimming="CharacterEllipsis" />

                  <ProgressBar x:Name="MediaProgress" Style="{StaticResource ThinProgress}"
                               Value="{Binding ProgressPercent, Mode=OneWay}" Margin="0,0,0,10"
                               MouseLeftButtonDown="OnMediaProgressClick"
                               ToolTip="Click to seek" />

                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;"
                            Click="OnPreviousClick" ToolTip="Previous" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryIconButton}" Content="{Binding PlayGlyph}"
                            Click="OnPlayPauseClick" ToolTip="Play / pause" Margin="0,0,8,0" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;"
                            Click="OnNextClick" ToolTip="Next" />
                  </StackPanel>
                </StackPanel>
              </Grid>

              <!-- Focus + system stats -->
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                  <StackPanel>
                    <TextBlock Text="FOCUS" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding FocusText}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" Typography.NumeralAlignment="Tabular" />
                    <ProgressBar Style="{StaticResource ThinProgress}" Height="3" Margin="0,2,0,8"
                                 Value="{Binding FocusPercent, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal">
                      <Button Content="{Binding FocusActionLabel}" Style="{StaticResource MiniButton}"
                              Click="OnFocusToggleClick" Margin="0,0,6,0" />
                      <Button Content="Reset" Style="{StaticResource GhostMiniButton}" Click="OnFocusResetClick" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="CPU" Style="{StaticResource CaptionText}" />
                      <TextBlock Text="{Binding CpuText}" Style="{StaticResource CaptionText}"
                                 Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Style="{StaticResource CoolProgress}" Height="4" Margin="0,5,0,10"
                                 Value="{Binding CpuPercent, Mode=OneWay}" />

                    <Grid>
                      <TextBlock Text="RAM" Style="{StaticResource CaptionText}" />
                      <TextBlock Text="{Binding MemorySummary}" Style="{StaticResource CaptionText}"
                                 Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Style="{StaticResource RamProgress}" Height="4" Margin="0,5,0,0"
                                 Value="{Binding MemoryPercent, Mode=OneWay}" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Grid>

          <!-- Footer -->
          <Grid Grid.Row="1" Margin="0,16,0,0">
            <Border Height="1" Background="#14FFFFFF" VerticalAlignment="Top" />
            <Grid Margin="0,10,0,0">
              <TextBlock Foreground="{StaticResource TextDimBrush}" FontSize="11.5">
                <Run Text="Click the desktop or press " />
                <Run Text="Esc" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <Run Text=" to collapse  ·  " />
                <Run Text="{Binding HotkeyHint}" />
              </TextBlock>
              <TextBlock HorizontalAlignment="Right" Text="DeskDot · D.R.M.Y ✨"
                         Foreground="{StaticResource AccentBrush}" FontSize="11.5" FontWeight="Bold" />
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
